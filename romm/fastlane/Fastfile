require "tmpdir"
require "shellwords"

default_platform(:ios)

# App Store Connect API key, read from environment (see fastlane/.env).
# Used for both reading the latest build number and the TestFlight upload —
# no Apple-ID login, no 2FA prompts.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false
  )
end

# Both schemes carry the same bundle ID, so their uploads land in the same App
# Store Connect record and look identical in the build list. Only the Delta core
# frameworks tell them apart, and shipping the wrong one is exactly the mistake
# that gets the app rejected under 4.3(a) again, so the built .ipa is inspected
# before anything is uploaded.
DELTA_FRAMEWORK = /DeltaCore/
DELTA_ASSETS = ["*.deltaskin", "*.deltamapping"].freeze

# The directory holding ./build, resolved from this file rather than from the
# current working directory, which fastlane does not guarantee.
def project_dir
  File.expand_path("..", __dir__)
end

def verify_ipa!(ipa_path, expect_delta_cores:)
  ipa_path = File.expand_path(ipa_path, project_dir) unless ipa_path.nil?
  UI.user_error!("No .ipa at #{ipa_path.inspect}") if ipa_path.nil? || !File.exist?(ipa_path)

  Dir.mktmpdir do |dir|
    sh("unzip", "-q", ipa_path, "-d", dir)
    app = Dir.glob(File.join(dir, "Payload", "*.app")).first
    UI.user_error!("No .app inside #{File.basename(ipa_path)}") if app.nil?

    frameworks = Dir.glob(File.join(app, "Frameworks", "*")).map { |f| File.basename(f) }
    delta_frameworks = frameworks.grep(DELTA_FRAMEWORK)
    delta_assets = DELTA_ASSETS.flat_map { |g| Dir.glob(File.join(app, "**", g)) }

    UI.message("#{frameworks.count} embedded frameworks, #{delta_frameworks.count} of them Delta")

    if expect_delta_cores
      if delta_frameworks.empty?
        UI.user_error!(
          "This build is meant to carry the Delta cores but embeds none. " \
          "Wrong scheme, or APP_STORE is set where it should not be."
        )
      end
    else
      unless delta_frameworks.empty?
        UI.user_error!(
          "App Store build still embeds Delta cores: #{delta_frameworks.join(', ')}. " \
          "Refusing to upload, this is the 4.3(a) rejection all over again."
        )
      end
      unless delta_assets.empty?
        names = delta_assets.map { |f| File.basename(f) }.uniq
        UI.user_error!("App Store build still ships Delta assets: #{names.join(', ')}")
      end

      # Frameworks and assets are not the whole story. A leftover credit line
      # pointing at the upstream Delta repos ships as plain text in the binary
      # and hands the reviewer the very comparison we are avoiding.
      #
      # The Delta *app's* bundle identifiers are a different matter and stay:
      # com.rileytestut.delta is how the handoff finds an installed Delta to
      # pass a ROM to, which is interop, not shared code. So this looks for
      # source references only, not for every mention of the name.
      binary = File.join(app, File.basename(app, ".app"))
      strings = `strings -a #{binary.shellescape}`
      mentions = strings.scan(%r{(?:github\.com/rileytestut\S*|\w*DeltaCore\w*)}).uniq
      unless mentions.empty?
        UI.user_error!(
          "App Store binary still references the Delta sources: " \
          "#{mentions.join(', ')}. Check LicensesView and any bundled docs."
        )
      end

      UI.success("App Store build is clean: no Delta frameworks, assets or credits")
    end
  end
end

# Next build number = highest in App Store Connect + 1. Both schemes share the
# app record, so this stays unique no matter which variant went up last.
# Applied via xcargs, so project.pbxproj stays untouched (no agvtool needed).
def next_build_number(api_key)
  latest_testflight_build_number(
    api_key: api_key,
    initial_build_number: 41
  ).to_i + 1
end

# Release notes ("What to Test"). Explicit override via TF_CHANGELOG, else the
# recent git commit subjects.
def release_notes
  changelog = ENV["TF_CHANGELOG"].to_s.strip
  return changelog unless changelog.empty?

  begin
    changelog_from_git_commits(
      commits_count: 15,
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges"
    )
  rescue StandardError
    nil
  end
end

def build_and_upload(scheme:, expect_delta_cores:, skip_upload:)
  api_key = asc_api_key
  build = next_build_number(api_key)

  # Let xcodebuild create/fetch the distribution certificate and regenerate the
  # App Store provisioning profile on demand during export, authenticating with
  # the App Store Connect API key. Requires the key to have the Admin role.
  # Absolute path, resolved relative to this fastlane dir so it's independent
  # of the current working directory (xcodebuild requires an absolute path).
  key_path = File.expand_path(File.basename(ENV["ASC_KEY_PATH"]), __dir__)
  UI.user_error!("API key not found at #{key_path}") unless File.exist?(key_path)

  prov_args = [
    "-allowProvisioningUpdates",
    "-authenticationKeyID", ENV["ASC_KEY_ID"],
    "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
    "-authenticationKeyPath", key_path
  ].join(" ")

  build_app(
    scheme: scheme,
    export_method: "app-store",
    xcargs: "CURRENT_PROJECT_VERSION=#{build}",
    export_xcargs: prov_args,
    export_options: {
      signingStyle: "automatic",
      teamID: "8J69P655GN"
    },
    output_directory: "./build",
    output_name: "#{scheme}-#{build}.ipa",
    clean: true
  )

  verify_ipa!(
    lane_context[SharedValues::IPA_OUTPUT_PATH],
    expect_delta_cores: expect_delta_cores
  )

  if skip_upload
    UI.success("Built #{scheme} build #{build}, upload skipped")
    return
  end

  changelog = release_notes
  upload_to_testflight(
    api_key: api_key,
    changelog: changelog,
    distribute_external: false,
    skip_waiting_for_build_processing: changelog.to_s.strip.empty?
  )

  UI.success("Uploaded #{scheme} build #{build} 🚀")
end

platform :ios do
  desc "Check that the App Store Connect API key works (no build/upload)"
  lane :verify do
    build = latest_testflight_build_number(
      api_key: asc_api_key,
      initial_build_number: 0
    )
    UI.success("API key OK — latest TestFlight build number: #{build}")
  end

  desc "Build and upload a new build to TestFlight (with the Delta cores)"
  lane :beta do |options|
    build_and_upload(
      scheme: "romm",
      expect_delta_cores: true,
      skip_upload: options[:skip_upload]
    )
  end

  desc "Inspect an already built .ipa without rebuilding it"
  lane :inspect_ipa do |options|
    path = options[:ipa] ||
      Dir.glob(File.join(project_dir, "build", "romm-AppStore-*.ipa")).max_by { |f| File.mtime(f) }
    UI.user_error!("No .ipa given and none found in build/") if path.nil?
    UI.message("Inspecting #{File.basename(path)}")
    verify_ipa!(path, expect_delta_cores: options[:expect_delta_cores] || false)
  end

  desc "Build and upload the App Store variant (without the Delta cores)"
  lane :appstore do |options|
    build_and_upload(
      scheme: "romm-AppStore",
      expect_delta_cores: false,
      skip_upload: options[:skip_upload]
    )
  end
end
