default_platform(:ios)

ENV['LC_ALL'] = 'en_US.UTF-8'
ENV['LANG'] = 'en_US.UTF-8'

PROJECT_PATH = 'romm/romm.xcodeproj'
DEFAULT_SCHEME = 'romm'
DEFAULT_TARGET = 'romm'

private_lane :resolve_optional_app_store_api_key do
  key_id = ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'].to_s.strip
  issuer_id = ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'].to_s.strip
  key_content = ENV['APP_STORE_CONNECT_API_KEY_KEY_CONTENT'].to_s.strip
  key_filepath = ENV['APP_STORE_CONNECT_API_KEY_KEY_FILEPATH'].to_s.strip

  if key_id.empty? || issuer_id.empty?
    UI.message('No App Store Connect API key configured - using Apple ID session from Xcode/App Store Connect account.')
    nil
  else
    if key_content.empty? && key_filepath.empty?
      UI.user_error!('API key ID/issuer found, but key material missing. Set APP_STORE_CONNECT_API_KEY_KEY_CONTENT or APP_STORE_CONNECT_API_KEY_KEY_FILEPATH.')
    end

    key_config = {
      key_id: key_id,
      issuer_id: issuer_id,
      duration: 1200,
      in_house: false
    }

    unless key_content.empty?
      key_config[:key_content] = key_content
      key_config[:is_key_content_base64] = ENV['APP_STORE_CONNECT_API_KEY_IS_BASE64'].to_s.downcase == 'true'
    end

    key_config[:key_filepath] = key_filepath unless key_filepath.empty?

    app_store_connect_api_key(**key_config)
  end
end

private_lane :release_changelog do
  changelog_from_git_commits(
    pretty: '- %s',
    commits_count: 15,
    merge_commit_filtering: 'exclude_merges'
  )
end

platform :ios do
  desc 'Increment build number, archive and upload to TestFlight, then tag the release'
  lane :deploy_testflight do
    # ensure_git_status_clean

    scheme = ENV['IOS_SCHEME'].to_s.strip
    scheme = DEFAULT_SCHEME if scheme.empty?

    target = ENV['IOS_APP_TARGET'].to_s.strip
    target = DEFAULT_TARGET if target.empty?

    api_key = resolve_optional_app_store_api_key

    build_number = increment_build_number(xcodeproj: PROJECT_PATH)
    version_number = get_version_number(xcodeproj: PROJECT_PATH, target: target)
    changelog = release_changelog

    commit_message = "chore(release): bump iOS build to #{build_number}"
    git_commit(
      path: ['romm/romm.xcodeproj/project.pbxproj'],
      message: commit_message
    )

    build_app(
      project: PROJECT_PATH,
      scheme: scheme,
      configuration: 'Release',
      clean: true,
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'romm.ipa'
    )

    upload_options = {
      changelog: changelog,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false
    }
    upload_options[:api_key] = api_key unless api_key.nil?
    upload_to_testflight(**upload_options)

    tag_name = "ios/v#{version_number}-b#{build_number}"
    add_git_tag(
      tag: tag_name,
      message: "TestFlight upload #{tag_name}"
    )

    # The in-app update hint compares the installed build against the one on
    # main, so the bump has to land there or every tester keeps being told they
    # are up to date. The release worktree runs on a detached HEAD, hence the
    # explicit branch names.
    #
    # The ancestor check is the safety net: it refuses to push when HEAD is not
    # built on top of origin/main, so a stray feature branch can never end up
    # there. The push itself is never forced, so a main that moved on fails
    # loudly instead of being overwritten.
    sh('git fetch origin main --quiet')
    unless sh('git merge-base --is-ancestor origin/main HEAD && echo yes || echo no', log: false).strip == 'yes'
      UI.user_error!('HEAD is not based on origin/main, refusing to push the build bump. Rebase the release worktree and push by hand.')
    end

    push_to_git_remote(
      local_branch: 'HEAD',
      remote_branch: 'main',
      tags: true
    )

    UI.success("Upload complete. Pushed build #{build_number} to main and tagged #{tag_name}")
  end

  desc 'Convenience alias for deploy_testflight'
  lane :deploy do
    deploy_testflight
  end

  desc 'Create App Store screenshots (Login + Settings) via snapshot'
  lane :screenshots do
    snapshot
  end
end
